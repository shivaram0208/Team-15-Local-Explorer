<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="18.0" styleClass="root-pane"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.localexplorer.app.EmergencyScreen">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label styleClass="title-label" text="Emergency" />
    <Label styleClass="subtitle-label" text="One tap connects you to help." />

    <HBox alignment="CENTER" spacing="14.0">
        <Button onAction="#callHospital" prefWidth="150.0" prefHeight="70.0" styleClass="emergency-button" text="Hospital" />
        <Button onAction="#callPolice" prefWidth="150.0" prefHeight="70.0" styleClass="emergency-button" text="Police" />
        <Button onAction="#callFire" prefWidth="150.0" prefHeight="70.0" styleClass="emergency-button" text="Fire" />
        <Button onAction="#callBloodBank" prefWidth="150.0" prefHeight="70.0" styleClass="emergency-button" text="Blood Bank" />
    </HBox>

    <Button onAction="#sendLocation" styleClass="primary-button" text="Send My Current Location" />
    <Label fx:id="statusLabel" styleClass="status-label" />

    <Button onAction="#backToDashboard" styleClass="link-button" text="← Back to Dashboard" />
</VBox>
