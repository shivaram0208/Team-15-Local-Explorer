<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="root-pane"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.localexplorer.app.DashboardScreen">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label fx:id="welcomeLabel" styleClass="title-label" text="Welcome" />
    <Label fx:id="weatherLabel" styleClass="subtitle-label" text="Loading weather..." />

    <HBox spacing="16.0">
        <Button onAction="#openMap" prefWidth="180.0" prefHeight="80.0" styleClass="tile-button" text="Interactive Map" />
        <Button onAction="#openBudget" prefWidth="180.0" prefHeight="80.0" styleClass="tile-button" text="Budget Tracker" />
        <Button onAction="#openEmergency" prefWidth="180.0" prefHeight="80.0" styleClass="tile-button" text="Emergency" />
    </HBox>
</VBox>
